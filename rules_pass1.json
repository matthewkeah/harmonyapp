{
  "_readme": {
    "pass": 1,
    "covers": "Units 1-5. Ranges, spacing, voice integrity, parallels, direct intervals, doubling (leading tone, triad positions, and seventh), triad completeness, and leaps.",
    "structure": "Every rule has: rule_id, tier, category, weight, error_message, check.",
    "handlers_registered_in": "sheria_pass1.py",
    "note_on_doubling": "Root doubling in a root-position triad is a tendency, not a rule. Only the leading tone and the chordal seventh must never be doubled.",
    "note_on_spacing": "Aldwell & Schachter Unit 5 §5 constrains adjacent voices only. There is no rule about S-B span.",
    "note_on_ranges": "Textbook ranges from Unit 5 §2 are extended by two semitones on each side to tolerate boundary excursions.",
    "note_on_six_four_doubling": "The doubling rules for second-inversion triads are strictest for the cadential 6/4. Passing and neighbouring 6/4s are more flexible and only fire when the doubling is clearly wrong. The INV2-DOUBLE-BASS rule is therefore restricted to six_four_types: [cadential].",
    "how_to_add_a_rule": [
      "1. Copy a rule block between { and }.",
      "2. Give it a new unique rule_id.",
      "3. Choose a check.type that Pass 1 or an earlier pass registered.",
      "4. Adjust the numbers inside check.",
      "5. Rewrite error_message in plain English.",
      "6. Save. No trailing comma after the last rule."
    ]
  },

